{
  "Logging": {
    "Console": { "FormatterName": "json" },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "None",
      "Microsoft.AspNetCore.Http.RequestDelegateFactory": "None",
      "Microsoft.AspNetCore.Http.Result": "None"
    }
  },
  "AllowedHosts": "*",
  "Limits": {
    "RunLifetimeSeconds": 600,
    "MaxActiveRuns": 1000,
    "MaxInvocationsPerRun": 50,
    "CleanupIntervalSeconds": 30,
    "CreationsPerIpPerMinute": 5,
    "CreationsPerMinute": 60,
    "InvocationsPerIpPerMinute": 60,
    "InvocationsPerMinute": 300,
    "ConcurrentInvocations": 16
  }
}
